# URL del webhook n8n que responde al chat del Asistente IA
VITE_WEBHOOK_URL=https://tu-instancia.app.n8n.cloud/webhook/geek-assistant

# Credenciales del proyecto Supabase (Auth + datos)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Google Analytics 4 (Measurement ID)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps JavaScript API key (requerida por src/map/map.js)
VITE_GOOGLE_MAPS_API_KEY=tu-google-maps-api-key
